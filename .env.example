# Copy to .env and fill in. DOCUMENTATION.md §3 describes every setting.

# Database. COVE_DATABASE_URL (the runtime role) is required. When
# COVE_MIGRATE_DATABASE_URL (the migrator role) is set, Cove applies pending
# migrations on startup.
COVE_DATABASE_URL=postgres://cove_app:password@localhost:5432/cove_db
COVE_MIGRATE_DATABASE_URL=postgres://cove_migrator:password@localhost:5432/cove_db

# Leave empty: Cove generates both on first start. Back up VAULT_ENCRYPTION_KEY;
# without it, stored secrets can't be decrypted.
COVE_CLIENT_SECRET=
VAULT_ENCRYPTION_KEY=

# DEV or PROD
APP_ENV=DEV
APP_PORT=2110
# File that generated secrets are saved to. Defaults to the .env that was loaded.
APP_ENV_PATH=.env
# Directory for the bootstrap marker file.
APP_MARKER_PATH=./markers
